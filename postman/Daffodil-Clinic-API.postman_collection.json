                "description": "status: active|inactive|all (default active)."
              }
            },
            {
              "name": "Get Schedule By Id",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/admin/schedules/{{scheduleId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "schedules", "{{scheduleId}}"]
                }
              }
            },
            {
              "name": "Set Schedule",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code < 300) {",
                      "  const body = pm.response.json();",
                      "  const id = body?.schedule?.id ?? body?.data?.id;",
                      "  if (id) pm.collectionVariables.set('scheduleId', id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"doctor_id\": \"{{doctorId}}\",\n  \"from\": \"2026-09-01T09:00:00.000Z\",\n  \"to\": \"2026-09-01T17:00:00.000Z\",\n  \"online_cases_number\": 5,\n  \"status\": \"active\",\n  \"max_appointments\": 10\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/admin/schedules/set",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "schedules", "set"]
                },
                "description": "doctor_id, from (> now), to (> from), online_cases_number (>=0) required. status (active|inactive), max_appointments (>=0) optional."
              }
            },
            {
              "name": "Set Multi Schedule",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"doctor_id\": \"{{doctorId}}\",\n  \"schedules\": [\n    { \"from\": \"2026-09-02T09:00:00.000Z\", \"to\": \"2026-09-02T17:00:00.000Z\" },\n    { \"from\": \"2026-09-03T09:00:00.000Z\", \"to\": \"2026-09-03T17:00:00.000Z\" }\n  ],\n  \"max_appointments_number\": 10,\n  \"online_cases_number\": 5\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/admin/schedules/set/multi",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "schedules", "set", "multi"]
                },
                "description": "doctor_id required. schedules: array (min 1) of {from > now, to > from}, required. online_cases_number required. max_appointments_number optional."
              }
            },
            {
              "name": "Toggle Schedule Status",
              "request": {
                "method": "PATCH",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/admin/schedules/toggle-status/{{scheduleId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "schedules", "toggle-status", "{{scheduleId}}"]
                },
                "description": "Toggles active<->inactive. 400 if the schedule has pending/scheduled appointments."
              }
            },
            {
              "name": "Forced Update Schedule",
