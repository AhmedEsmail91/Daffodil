                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"from\": \"2026-09-01T10:00:00.000Z\",\n  \"to\": \"2026-09-01T18:00:00.000Z\",\n  \"online_cases_number\": 6\n}"
                },
