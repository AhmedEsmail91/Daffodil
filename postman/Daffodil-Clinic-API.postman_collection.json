                "url": {
                  "raw": "{{baseUrl}}/admin/appointments?page=1&limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "appointments"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "10" },
                    { "key": "sort", "value": "", "disabled": true },
                    { "key": "keyword", "value": "", "disabled": true }
                  ]
                }
              }
            },
            {
              "name": "Get Appointment By Id",
              "request": {
                "method": "GET",
                "header": [],
