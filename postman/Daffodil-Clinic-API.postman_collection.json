            {
              "name": "Get All Scopes",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/admin/scopes",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "scopes"]
                }
              }
            },
            {
              "name": "Delete Scope",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/admin/scopes/{{scopeId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "scopes", "{{scopeId}}"]
                }
              }
            }
          ]
        },
