                  "raw": "{{baseUrl}}/admin/appointments/{{appointmentId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "appointments", "{{appointmentId}}"]
                }
              }
            },
            {
              "name": "Update Appointment Status",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"scheduled\",\n  \"appointment_mode\": \"online\",\n  \"type\": \"consultation\",\n  \"notes\": \"Confirmed with patient by phone.\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/admin/appointments/{{appointmentId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "appointments", "{{appointmentId}}"]
                },
                "description": "status is required (pending|scheduled|canceled|completed). appointment_mode (online|in-person), type (consultation|follow-up|emergency), notes (<=1000 chars) are optional. Only appointments currently 'pending' can be updated (unless setting status=canceled). Non-cancel updates also create a Google Calendar event + OnlineMeeting record."
              }
            }
          ]
        },
        {
          "name": "Schedules",
          "item": [
            {
              "name": "Get All Schedules",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/admin/schedules/?status=active&page=1&limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "schedules", ""],
                  "query": [
                    { "key": "status", "value": "active" },
