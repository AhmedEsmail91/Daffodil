{
  "info": {
    "name": "Daffodil Clinic API",
    "description": "Full API surface for the Daffodil Clinic backend (Express + Sequelize/Postgres + Firestore chat).\n\n**Auth**: login sets an httpOnly `token` JWT cookie. Postman's cookie jar carries it automatically for subsequent requests to the same host, so you normally don't need to do anything else after running \"Login\". As a fallback, `Auth.Authenticate` also accepts `Authorization: Bearer <jwt>` or a raw `token` header — the Login request's test script also copies the cookie value into the `{{token}}` collection variable and the collection's default auth is Bearer `{{token}}`, so either mechanism works.\n\n**Roles**: `admin`, `doctor`, `user` (this is the patient role). Most admin routes require specific permissions on top of being authenticated (see each folder's description) — note the permission-seeder currently grants every permission to every role, so in practice any authenticated user can call any endpoint in this instance, but the intended checks are documented per-request anyway.\n\n**Known issues found while mapping routes** (documented per-request below too):\n- `POST /api/auth/refresh` references an undefined `createAccessToken` function and no login flow ever sets a `refreshToken` cookie — this endpoint is broken end-to-end.\n- `GET /api/doctor/appointments` and `PATCH /api/doctor/appointments/:id` reuse the *admin* controllers, so they are not scoped to the calling doctor (all appointments are visible/editable, not just the doctor's own).\n- `GET/PUT /api/patient/schedules` similarly reuse the admin-wide schedule listing, not patient-filtered.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [],
  "variable": [
    { "key": "serverUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "baseUrl", "value": "{{serverUrl}}/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "adminEmail", "value": "admin@gmail.com", "type": "string" },
    { "key": "adminPassword", "value": "Qw123456789@#$", "type": "string" },
    { "key": "specialtyId", "value": "", "type": "string" },
    { "key": "scopeId", "value": "", "type": "string" },
    { "key": "scheduleId", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "doctorId", "value": "", "type": "string" },
    { "key": "doctorUserId", "value": "", "type": "string" },
    { "key": "roleId", "value": "", "type": "string" },
    { "key": "permissionId", "value": "", "type": "string" },
    { "key": "chatId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Local (email/password) auth plus Google OAuth entry points. Mounted directly at /api/auth, not under admin/doctor/patient.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Sets an httpOnly `token` cookie (1h) on success and returns the logged-in user. `password` must match ^(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])(?=.*[#?!@$%^&*-]).{8,}$ if you swap in a different account. Rejects doctor accounts that aren't yet approved."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const cookie = pm.cookies.get('token');",
                  "  if (cookie) { pm.collectionVariables.set('token', cookie); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns {id,name,email,role:{id,name},lang} for the current session. Requires auth."
          }
        },
        {
          "name": "Get Firebase Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/firebase-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "firebase-token"]
            },
            "description": "Mints a Firebase custom token for the current user so a client can sign into Firebase for chat (signInWithCustomToken). Requires auth."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current\": \"{{adminPassword}}\",\n  \"new\": \"NewPass123!\",\n  \"reNew\": \"NewPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/changePassword",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "changePassword"]
            },
            "description": "current/new/reNew must all satisfy the password pattern (min 8 chars, upper+lower+digit+special). reNew must equal new. Requires auth. Re-issues the token cookie (15 min)."
          }
        },
        {
          "name": "Refresh Token (broken)",
          "request": {
            "method": "POST",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            },
            "description": "KNOWN BUG: the controller calls an undefined `createAccessToken` function, and no route ever sets the `refreshToken` cookie this endpoint reads. Calling this will throw a server error. Kept here for completeness/documentation."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            },
            "description": "Clears token/refreshToken/role cookies."
          }
        },
        {
          "name": "Google OAuth - Doctor (browser only)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/auth/google/doctor/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google", "doctor", ""]
            },
            "description": "Redirects to Google's consent screen (requests Calendar scope too). Not a JSON API call — open this URL in a browser, don't 'Send' it in Postman."
          }
        },
        {
          "name": "Google OAuth - Patient (browser only)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/auth/google/patient/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google", "patient", ""]
            },
            "description": "Redirects to Google's consent screen (no Calendar scope). Not a JSON API call — open this URL in a browser, don't 'Send' it in Postman."
          }
        },
        {
          "name": "Google OAuth Callback (browser only)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "noauth" },
            "url": {
              "raw": "{{baseUrl}}/auth/google/callback",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google", "callback"]
            },
            "description": "Handled automatically by Google's redirect after consent; sets the token cookie and 302s to the frontend. Not directly callable from Postman."
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "All routes under /api/admin require auth + the permission set (doctor-create, schedule-read, schedule-update, schedule-delete) applied at the router level, plus any further per-route permission listed below. Note: the current seeder grants every permission to every role, so in this instance any authenticated user can technically call these.",
      "item": [
        {
          "name": "Specialties",
          "item": [
            {
              "name": "Get All Specialties",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/admin/specialties?page=1&limit=10&sort=-createdAt&keyword=",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "specialties"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "limit", "value": "10" },
                    { "key": "sort", "value": "-createdAt" },
                    { "key": "keyword", "value": "", "disabled": true }
                  ]
                },
                "description": "Requires permission: specialty-read."
              }
            },
            {
              "name": "Create Specialty",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code < 300) {",
                      "  const body = pm.response.json();",
                      "  const id = body?.specialty?.id;",
                      "  if (id) pm.collectionVariables.set('specialtyId', id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name_en\": \"Hair Transplant\",\n  \"name_ar\": \"زراعة الشعر\",\n  \"description_en\": \"Hair restoration and transplantation procedures.\",\n  \"description_ar\": \"إجراءات ترميم وزراعة الشعر.\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/admin/specialties",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "specialties"]
                },
                "description": "Requires permissions: specialty-create, specialty-read, specialty-update, specialty-delete (all). name_en/name_ar: 2-100 chars. description_en/description_ar: 10-500 chars. 400 if name already exists."
              }
            },
            {
              "name": "Get Specialty By Id",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/admin/specialties/{{specialtyId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "specialties", "{{specialtyId}}"]
                },
                "description": "Requires permission: specialty-read."
              }
            },
            {
              "name": "Update Specialty",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"description_en\": \"Updated description for hair transplant specialty.\",\n  \"description_ar\": \"وصف محدث لتخصص زراعة الشعر.\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/admin/specialties/{{specialtyId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "specialties", "{{specialtyId}}"]
                },
                "description": "Requires all 4 specialty permissions. Only description_en/description_ar are updatable; both required (10-500 chars). :id comes from the URL, no need to repeat it in the body."
              }
            },
            {
              "name": "Delete Specialty",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/admin/specialties/{{specialtyId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["admin", "specialties", "{{specialtyId}}"]
                },
                "description": "Requires all 4 specialty permissions. 400 if any doctors are still assigned to this specialty."
              }
            }
          ]
        },
        {
          "name": "Scopes",
          "item": [
            {
              "name": "Create Scope",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code < 300) {",
                      "  const body = pm.response.json();",
                      "  const id = body?.scope?.id ?? body?.data?.id;",
                      "  if (id) pm.collectionVariables.set('scopeId', id);",
                      "}"
